#Exercise 6:
product_name=input("Enter product name: ")
retail_price=float(input("Enter product price: "))
product_quantity=int(input("Enter product quantity: "))
unit_cost=float(input("Enter product unit cost: "))
discount_percent=float(input("Enter discount percent: "))

revenue=retail_price*product_quantity
discount_amount=revenue*discount_percent / 100
revenue_after_discount=revenue-discount_amount
gross_margin=(retail_price-unit_cost)/retail_price
net_profit=revenue_after_discount-(unit_cost*product_quantity)
print("="*50)
#output
print(f"Product Name: {product_name}")
print(f"Revenue After Discount: ${revenue_after_discount:,.2f}")
print(f"Revenue Before Discount: ${revenue:,.2f}")
print(f"Gross Margin: {gross_margin:.1%}")
print(f"Net Profit: ${net_profit:,.2f}")

